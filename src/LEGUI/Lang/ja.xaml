    <system:String x:Key="WithCreateSuspended">プロセスを一時停止状態で起動（デバッグ用）</system:String>
    <system:String x:Key="Miscellaneous">その他</system:String>
    <system:String x:Key="ShowInMainMenu">メインメニューにこのプロファイルを表示</system:String>

    <!-- PR 29 新增的 24 個 key（Issue #21） -->
    <system:String x:Key="InstallSuccess">シェル拡張のインストールに成功しました。反映するには Explorer を再起動するか、サインアウトしてください。</system:String>
    <system:String x:Key="UninstallSuccess">シェル拡張のアンインストールに成功しました。反映するには Explorer を再起動するか、サインアウトしてください。</system:String>
    <system:String x:Key="InstallShellExtTitle">シェル拡張</system:String>
    <system:String x:Key="InstallCurrentUser">インストール（現在のユーザー）</system:String>
    <system:String x:Key="InstallAllUsers">インストール（すべてのユーザー）</system:String>
    <system:String x:Key="Uninstall">アンインストール</system:String>
    <system:String x:Key="InstallStatus">状態：</system:String>
    <system:String x:Key="Installed">インストール済み</system:String>
    <system:String x:Key="NotInstalled">未インストール</system:String>
    <system:String x:Key="Display">表示</system:String>
    <system:String x:Key="AsAdminTip">対象プロセスを昇格された権限で起動します。一部のゲームで必要です。</system:String>
    <system:String x:Key="RedirectRegistryTip">ロケール関連のレジストリ読み取りを傍受し、システムの値ではなくエミュレートされたロケールを返します。</system:String>
    <system:String x:Key="IsAdvancedRedirectionTip">システム UI 言語を制御するレジストリキーもリダイレクトし、MUI_LANGUAGE_NAME で問い合わせる一部アプリに影響します。</system:String>
    <system:String x:Key="WithCreateSuspendedTip">対象プロセスを一時停止状態で作成します（高度なデバッグオプション）。</system:String>
    <system:String x:Key="ShowInMainMenuTip">このプロファイルをサブメニュー内ではなく、右クリックメニューのルートに直接表示します。</system:String>
    <system:String x:Key="TabProfile">プロファイル</system:String>
    <system:String x:Key="TabShellExtension">シェル拡張</system:String>
    <system:String x:Key="TabAbout">バージョン情報</system:String>
    <system:String x:Key="SavedStatus">保存済み</system:String>
    <system:String x:Key="ShellExtCurrentUserHeader">現在のユーザー</system:String>
    <system:String x:Key="ShellExtAllUsersHeader">すべてのユーザー &#x1F6E1;</system:String>
    <system:String x:Key="ShellExtOldResidueDetected">&#x26A0; 旧バージョンの残存を検出</system:String>
    <system:String x:Key="ShellExtCleanupOld">旧登録をクリーンアップ</system:String>
    <system:String x:Key="ShellExtOperationFailed">シェル拡張の操作に失敗しました：{0}</system:String>

    <!-- Task 2 從寫死字串抽出的 15 個新 key -->
    <system:String x:Key="AppName">Locale Emulator</system:String>
    <system:String x:Key="Ok">OK</system:String>
    <system:String x:Key="AboutTitle">Locale Emulator (ooxxTaiwan fork)</system:String>
    <system:String x:Key="AboutVersion">バージョン </system:String>
    <system:String x:Key="AboutOriginalProject">原プロジェクト</system:String>
    <system:String x:Key="AboutCore">Core（2022 年 4 月にアーカイブ）</system:String>
    <system:String x:Key="AboutThisFork">本 fork</system:String>
    <system:String x:Key="AboutLicense">ライセンス：LGPL-3.0</system:String>
    <system:String x:Key="AboutCoreLicense">Core 部分：LGPL-3.0 / GPL-3.0</system:String>
    <system:String x:Key="AppConfigTitle">LEGUI - </system:String>
    <system:String x:Key="GlobalConfigTitle">LEGUI グローバル</system:String>
    <system:String x:Key="ErrorHomeDirNotWritable">ホームディレクトリに書き込み権限がありません。&#x0A;LE を別の場所に移動してから再試行してください。&#x0A;ホームディレクトリ：{0}</system:String>
    <system:String x:Key="ErrorDirNotWritable">ディレクトリに書き込み権限がありません。&#x0A;代わりにグローバルプロファイルを使用してください。&#x0A;現在のディレクトリ：{0}</system:String>
    <system:String x:Key="ErrorAdminRequired">LEGUI が現在のディレクトリに書き込むには管理者権限が必要です。</system:String>
    <system:String x:Key="ShortcutDescription">Locale Emulator で {0} を実行</system:String>
</ResourceDictionary>
